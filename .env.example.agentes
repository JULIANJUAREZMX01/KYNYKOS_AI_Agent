# Variables de entorno — copia a .env (NUNCA subas .env). Valores reales solo en el host o en Secrets.

# Clave del proveedor LLM principal [SECRETO]
OPENAI_API_KEY=

# Token del bot (solo valor real en el host) [SECRETO]
TELEGRAM_BOT_TOKEN=

# Lista blanca de comandos permitidos, separada por comas
ALLOWED_TOOL_COMMANDS=
